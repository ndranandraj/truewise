# Cloudflare Workers static-asset cache policy.
# Without this file the platform default is "public, max-age=0, must-revalidate", i.e. no
# real browser caching: styles.css, fonts, and the large JSON shards revalidate on every
# navigation. Durations are kept modest so the monthly data refresh still lands promptly,
# and the post-deploy cache purge already clears the edge on each deploy.
# Note: Workers _headers allows only ONE splat (*) per URL pattern, so each data path is
# listed explicitly rather than /*/data/*.

# Baseline security headers on every response. The CSP is matched to the resources the site
# actually loads: inline <script>/<style> (hence 'unsafe-inline'), Google Fonts, and the
# cookieless Cloudflare beacon. 'unsafe-inline' is a real weakening, but the pages are static
# and load no third-party scripts beyond the beacon, so the practical risk is low and the
# frame-ancestors/nosniff/HSTS protections are the meaningful wins. Revisit CSP if inline JS
# is ever moved to external files.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# The /embed/ widget is meant to be iframed by other sites (journalists, schools), so it opts
# OUT of the sitewide frame block: unset the legacy X-Frame-Options and set a CSP that allows any
# frame-ancestor. This more-specific rule overrides the /* CSP for /embed/ paths. Everything else
# on the site stays frame-denied. (There is no auth or state-changing action to clickjack here.)
/embed/*
  ! X-Frame-Options
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors *; base-uri 'self'; object-src 'none'

# Stylesheet and icons: change rarely, safe to hold for an hour.
/styles.css
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400

# Generated data shards (the heavy payloads): one day.
/value-check/data/*
  Cache-Control: public, max-age=86400
/careers/data/*
  Cache-Control: public, max-age=86400
/k12/data/*
  Cache-Control: public, max-age=86400

# Downloadable datasets under /data/.
/data/*
  Cache-Control: public, max-age=86400

# Pre-rendered HTML pages: an hour lets a repeat visitor navigate instantly while still
# picking up the monthly rebuild within the day.
/college/*
  Cache-Control: public, max-age=3600
/colleges/*
  Cache-Control: public, max-age=3600
/majors/*
  Cache-Control: public, max-age=3600
/lists/*
  Cache-Control: public, max-age=3600
