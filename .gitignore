# FVT Monitor: keep provenance + the compact dated snapshot, ignore the bulky raw dumps
archive/**/*.zip
archive/**/*.csv

# ...but DO keep the compact dated Monitor snapshots
!archive/**/*.parquet

# Bundled dataset inside the pip package (tracked)
!packages/**/*.parquet
/docs/GO_PUBLISH.md

# Python build artifacts inside packages
packages/**/build/
packages/**/dist/
packages/**/*.egg-info/

# Generated site data is built at deploy time, not committed (kept lean).
site/value-check/data/
site/careers/data/
site/k12/data/
site/data/value_check_summary.json
# Downloadable datasets are copied into site/data/ at deploy time (already ignored by *.parquet):
site/data/*.parquet
# Pre-rendered college/state/major/findings pages are generated at deploy, not committed:
site/college/
site/colleges/
site/majors/
site/findings/
site/lists/
# The list CSVs are generated from the same rows those pages render, by the same run.
site/data/lists/
site/updates/
# Regenerated by build_sitemap on every deploy. The tracked copy had gone stale at 15 URLs
# against 6,548 live, and committing it adds 6,500 lines of noise to unrelated diffs.
site/sitemap.xml
site/sitemap-*.xml
# Social share cards are rendered at deploy by the page builders, per-page and site-root alike:
site/og/
# ...and the site-root card, which pipeline.og_images rewrites on every deploy exactly like the
# per-page ones above. Tracking it meant the committed copy differed from any local render by tens
# of thousands of pixels purely from a different FreeType, while production shipped whatever CI
# rendered. Same defect as the tracked sitemap: a generated artefact under version control tells you
# about the machine that last built it, not about the site.
site/og.png
# ...but the compact parquet build-source IS tracked:
!published/*.parquet
/docs/GO_DEPLOY.md

# Design audit workbook + redesign plans (local, not published)
design-audit-*/
truewise-redesign-*.md
truewise-audit-triage-*.md
TRUEWISE_*.md
truewise-stage*.md
truewise-font-*.md

# Node deps. package.json IS committed so `npm install` is reproducible and so installing one
# package can no longer prune the others; the tree and the lock are not.
#
# That pruning is not hypothetical. With no package.json, `npm install playwright` removed jsdom and
# axe-core and reported only "removed 39 packages", which would have left five smoke suites unable to
# start on the next clean checkout.
node_modules/
package-lock.json

# Playwright's browser binaries, and everything the layout check writes (screenshots, reports).
# Browsers are ~170 MB and machine-specific; the reports are evidence for a single run.
.playwright-browsers/
layout-check-*/

# Stage 4.1 canonical-profile pilot (measurements only, never deployed)
pilot/

# Deployed copies of the isolated component assets (source in components/, copied at build)
/site/components.css
# Generated-page styles, written from PG_CSS in build_college_pages.py.
/site/pg.css
/site/components/

# Staged canonical profiles (Stage 4.3b; built and reviewed before the Stage 5 cutover, never deployed)
staging/
